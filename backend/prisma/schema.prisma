generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Core Tables (names & fields immutable) ====================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  name          String
  avatar_url    String?
  role          String   @default("user") // global: admin | user
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  owned_teams      Team[]           @relation("TeamOwner")
  team_memberships TeamMember[]
  owned_projects   Project[]        @relation("ProjectOwner")
  project_memberships ProjectMember[]
  assigned_tasks   Task[]           @relation("TaskAssignee")
  created_tasks    Task[]           @relation("TaskCreator")
  comments         Comment[]
  mentions         Mention[]
  attachments      Attachment[]
  activities       Activity[]
  notifications    Notification[]
  settings         UserSetting?
  sessions         Session[]
  password_history PasswordHistory[]
  audit_logs       AuditLog[]       @relation("AuditUser")
  sent_invitations Invitation[]     @relation("InvitationSender")

  last_login_at    DateTime?
  failed_login_attempts Int @default(0)
  locked_until     DateTime?

  @@map("users")
}

model Team {
  id         String   @id @default(cuid())
  name       String
  timezone   String   @default("UTC")
  logo_url   String?
  owner_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  owner       User         @relation("TeamOwner", fields: [owner_id], references: [id])
  members     TeamMember[]
  projects    Project[]
  webhooks    Webhook[]
  invitations Invitation[]

  @@map("teams")
}

model TeamMember {
  team_id    String
  user_id    String
  role       String   // owner | admin | member | viewer
  invited_at DateTime?
  joined_at  DateTime @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([team_id, user_id])
  @@map("team_members")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("active") // active | archived
  color       String?
  icon        String?
  is_public   Boolean   @default(false)
  team_id     String
  owner_id    String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime?
  deleted_at  DateTime? // soft delete
  start_date  DateTime?
  end_date    DateTime?
  default_assignee_id String?

  // Relations
  team        Team            @relation(fields: [team_id], references: [id], onDelete: Cascade)
  owner       User            @relation("ProjectOwner", fields: [owner_id], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  tags        Tag[]
  templates   Template[]
  task_counter Int            @default(0)

  @@unique([team_id, name])
  @@map("projects")
}

model ProjectMember {
  project_id String
  user_id    String
  role       String   // owner | admin | member | viewer
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@map("project_members")
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("todo") // backlog | todo | in-progress | review | done
  priority        String    @default("medium") // low | medium | high | urgent
  due_date        DateTime?
  start_date      DateTime?
  project_id      String
  assignee_id     String?
  creator_id      String
  parent_id       String?
  task_number     String?   // PROJ-001 format
  estimated_hours Float?
  position        Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  completed_at    DateTime?
  deleted_at      DateTime? // soft delete

  // Relations
  project      Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee     User?            @relation("TaskAssignee", fields: [assignee_id], references: [id])
  creator      User             @relation("TaskCreator", fields: [creator_id], references: [id])
  parent       Task?            @relation("TaskParent", fields: [parent_id], references: [id])
  subtasks     Task[]           @relation("TaskParent")
  dependencies TaskDependency[] @relation("TaskDep")
  dependents   TaskDependency[] @relation("TaskDepOn")
  comments     Comment[]
  attachments  Attachment[]
  activities   Activity[]
  task_tags    TaskTag[]
  watchers     TaskWatcher[]

  @@index([project_id])
  @@index([assignee_id])
  @@index([status])
  @@index([parent_id])
  @@index([deleted_at])
  @@map("tasks")
}

model TaskDependency {
  task_id            String
  depends_on_task_id String
  type               String // before | after

  task      Task @relation("TaskDep", fields: [task_id], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDepOn", fields: [depends_on_task_id], references: [id], onDelete: Cascade)

  @@id([task_id, depends_on_task_id])
  @@map("task_dependencies")
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  task_id    String
  author_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
  edited_at  DateTime?

  task     Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [author_id], references: [id])
  mentions Mention[]

  @@index([task_id])
  @@map("comments")
}

model Mention {
  comment_id String
  user_id    String

  comment Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@id([comment_id, user_id])
  @@map("mentions")
}

model Attachment {
  id          String   @id @default(cuid())
  filename    String
  mime_type   String
  size        Int
  md5         String
  path        String
  task_id     String
  uploaded_by String
  uploaded_at DateTime @default(now())
  deleted_at  DateTime?

  task     Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaded_by], references: [id])

  @@index([task_id])
  @@index([md5])
  @@map("attachments")
}

model Activity {
  id         String   @id @default(cuid())
  task_id    String?
  project_id String?
  team_id    String?
  user_id    String
  action     String
  entity_type String? // task | project | team | user | comment | attachment
  entity_id  String?
  old_value  String?
  new_value  String?
  metadata   String?  // JSON string for extra info (IP, User-Agent, etc.)
  created_at DateTime @default(now())

  task Task? @relation(fields: [task_id], references: [id], onDelete: SetNull)
  user User  @relation(fields: [user_id], references: [id])

  @@index([task_id])
  @@index([project_id])
  @@index([user_id])
  @@index([created_at])
  @@map("activities")
}

model Notification {
  id         String   @id @default(cuid())
  user_id    String
  type       String   // mention | assignment | status_change | comment | invitation | system
  title      String
  body       String?
  is_read    Boolean  @default(false)
  priority   String   @default("normal") // normal | high
  link       String?  // link to the related resource
  created_at DateTime @default(now())
  archived_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
  @@map("notifications")
}

model Webhook {
  id         String   @id @default(cuid())
  team_id    String
  url        String
  events     String[] // ["task.created", "task.updated", "task.completed"]
  secret     String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  team       Team              @relation(fields: [team_id], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([team_id])
  @@map("webhooks")
}

// ==================== Additional Tables ====================

model Tag {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#3B82F6")
  description String?
  project_id  String
  created_at  DateTime @default(now())

  project   Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  task_tags TaskTag[]

  @@unique([project_id, name])
  @@map("tags")
}

model TaskTag {
  task_id String
  tag_id  String

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([task_id, tag_id])
  @@map("task_tags")
}

model Template {
  id               String   @id @default(cuid())
  name             String
  title_prefix     String?
  description      String?
  priority         String   @default("medium")
  estimated_hours  Float?
  project_id       String
  is_default       Boolean  @default(false)
  usage_count      Int      @default(0)
  default_tags     String[] // tag IDs
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("templates")
}

model UserSetting {
  id                    String  @id @default(cuid())
  user_id               String  @unique
  email_notification    String  @default("realtime") // realtime | daily | off
  websocket_enabled     Boolean @default(true)
  default_board_columns String? // JSON array
  default_sort          String  @default("priority") // priority | due_date | created_at
  theme                 String  @default("light") // light | dark
  timezone              String  @default("UTC")
  privacy_mode          Boolean @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  user_id     String
  action      String
  entity_type String
  entity_id   String?
  details     String?  // JSON
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user User @relation("AuditUser", fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

model TrashItem {
  id          String   @id @default(cuid())
  entity_type String   // task | project
  entity_id   String
  deleted_by  String
  deleted_at  DateTime @default(now())
  expires_at  DateTime // 30 days from deletion
  metadata    String?  // JSON snapshot of the deleted entity

  @@index([entity_type, entity_id])
  @@index([expires_at])
  @@map("trash_items")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhook_id   String
  event        String
  payload      String   // JSON
  status_code  Int?
  response     String?
  duration_ms  Int?
  success      Boolean  @default(false)
  attempts     Int      @default(1)
  created_at   DateTime @default(now())

  webhook Webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id])
  @@map("webhook_deliveries")
}

model Invitation {
  id          String   @id @default(cuid())
  team_id     String
  token       String   @unique
  role        String   @default("member")
  sender_id   String
  max_uses    Int?     // null = unlimited
  use_count   Int      @default(0)
  expires_at  DateTime
  created_at  DateTime @default(now())

  team   Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  sender User @relation("InvitationSender", fields: [sender_id], references: [id])

  @@index([token])
  @@map("invitations")
}

model Session {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  expires_at DateTime
  last_used  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@map("sessions")
}

model PasswordHistory {
  id            String   @id @default(cuid())
  user_id       String
  password_hash String
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_history")
}

model TaskWatcher {
  task_id String
  user_id String

  @@id([task_id, user_id])
  @@map("task_watchers")
}
